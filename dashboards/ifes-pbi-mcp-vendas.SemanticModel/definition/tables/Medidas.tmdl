table Medidas
	lineageTag: bc5a0d18-53a9-42ca-ba07-59354dc4292e

	measure txtAtualizacao = "Atualização: " & MAX(Atualizacao[Data e Hora])
		displayFolder: 0. Aux
		lineageTag: 97da66ff-53c2-478e-91bb-da888222b682

	measure Dummy = {0}
		formatString: 0
		displayFolder: 0. Aux
		lineageTag: 3581f06a-c2d1-44f6-bab6-7702f11c7db4

	/// Soma de Quantidade × PrecoUnitario dos pedidos faturados, antes do desconto.
	measure 'Receita Bruta' =
			CALCULATE(
			    SUMX(fato_vendas, fato_vendas[Quantidade] * fato_vendas[PrecoUnitario]),
			    fato_vendas[Status] = "Faturado"
			)
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: d770164e-f96f-4c21-8af1-8dd95482a864

	/// Receita líquida dos pedidos faturados: Σ Quantidade × PrecoUnitario × (1 − DescontoPct).
	measure Receita =
			CALCULATE(
			    SUMX(fato_vendas, fato_vendas[Quantidade] * fato_vendas[PrecoUnitario] * (1 - fato_vendas[DescontoPct])),
			    fato_vendas[Status] = "Faturado"
			)
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 90935420-8710-47e8-a515-3666026cd4d1

	/// Valor concedido em desconto nos pedidos faturados (Receita Bruta − Receita).
	measure Desconto = [Receita Bruta] - [Receita]
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 557ab5cd-678f-4d2e-afb3-5c955487af04

	/// Desconto sobre a Receita Bruta dos pedidos faturados.
	measure 'Desconto %' = DIVIDE([Desconto], [Receita Bruta])
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 510f0c4d-5806-4445-bdf7-24cde39c8a36

	/// Custo dos pedidos faturados: Σ Quantidade × CustoUnitario.
	measure Custo =
			CALCULATE(
			    SUMX(fato_vendas, fato_vendas[Quantidade] * fato_vendas[CustoUnitario]),
			    fato_vendas[Status] = "Faturado"
			)
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 4f093b82-a45e-4516-8460-be1fefc7ce1e

	/// Receita menos Custo dos pedidos faturados.
	measure 'Margem Bruta' = [Receita] - [Custo]
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 61edf1b8-e69f-4050-9de0-40ecca07483a

	/// Margem Bruta sobre a Receita.
	measure 'Margem Bruta %' = DIVIDE([Margem Bruta], [Receita])
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 556b95d1-6abd-4124-b0ab-ebb2c90ae0da

	/// Unidades vendidas nos pedidos faturados.
	measure 'Quantidade Vendida' = CALCULATE(SUM(fato_vendas[Quantidade]), fato_vendas[Status] = "Faturado")
		formatString: #,##0
		displayFolder: 1. Vendas
		lineageTag: 17c516b7-31b5-4e11-90ed-1582c9e8c60c

	/// Quantidade de pedidos faturados distintos.
	measure Pedidos = CALCULATE(DISTINCTCOUNT(fato_vendas[PedidoID]), fato_vendas[Status] = "Faturado")
		formatString: #,##0
		displayFolder: 1. Vendas
		lineageTag: 5c0bb03a-f474-4539-888d-804f2185da4a

	/// Quantidade de pedidos com Status = Cancelado.
	measure 'Pedidos Cancelados' = CALCULATE(DISTINCTCOUNT(fato_vendas[PedidoID]), fato_vendas[Status] = "Cancelado")
		formatString: #,##0
		displayFolder: 1. Vendas
		lineageTag: e9b916c6-43e3-410f-97c1-6d81650a6735

	/// Pedidos cancelados sobre o total de pedidos (faturados + cancelados).
	measure 'Taxa de Cancelamento %' = DIVIDE([Pedidos Cancelados], [Pedidos] + [Pedidos Cancelados])
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: a435003a-bad2-4fc4-8659-c126cbd09c7d

	/// Receita por pedido faturado.
	measure 'Ticket Médio' = DIVIDE([Receita], [Pedidos])
		formatString: "R$" #,##0.00
		displayFolder: 1. Vendas
		lineageTag: 212aa855-97d4-4214-810d-758423c32400

	/// Clientes distintos com ao menos um pedido faturado no contexto.
	measure 'Clientes Ativos' = CALCULATE(DISTINCTCOUNT(fato_vendas[ClienteID]), fato_vendas[Status] = "Faturado")
		formatString: #,##0
		displayFolder: 1. Vendas
		lineageTag: 23245d12-0e32-4cfe-ab73-11794896684d

	/// Soma de MetaValor (grão mês × vendedor, ligada ao calendário pelo dia 1 do mês; filtro diário sem o dia 1 devolve vazio).
	measure Meta = SUM(metas_mensais[MetaValor])
		formatString: "R$" #,##0.00
		displayFolder: 2. Meta
		lineageTag: b54f00da-f239-486c-8fae-873250c874f4

	/// Receita sobre a Meta. Vazio quando não há meta ou receita no contexto, ou quando há filtro de cliente, produto, canal ou status (a meta não se divide por essas dimensões).
	measure 'Atingimento %' =
			VAR _meta = [Meta]
			VAR _receita = [Receita]
			VAR _recorteSemMeta =
			    ISFILTERED(dim_clientes) || ISFILTERED(dim_produtos)
			        || ISFILTERED(fato_vendas[Canal]) || ISFILTERED(fato_vendas[Status])
			RETURN IF(_recorteSemMeta || ISBLANK(_meta) || ISBLANK(_receita), BLANK(), DIVIDE(_receita, _meta))
		formatString: 0.0%
		displayFolder: 2. Meta
		lineageTag: 21801152-b494-4d56-b21f-9ee9c7c5058e

	/// Receita menos Meta: positivo = acima da meta, negativo = abaixo. Vazio sem meta ou com filtro de cliente, produto, canal ou status.
	measure 'Gap Meta' =
			VAR _meta = [Meta]
			VAR _recorteSemMeta =
			    ISFILTERED(dim_clientes) || ISFILTERED(dim_produtos)
			        || ISFILTERED(fato_vendas[Canal]) || ISFILTERED(fato_vendas[Status])
			RETURN IF(_recorteSemMeta || ISBLANK(_meta), BLANK(), [Receita] - _meta)
		formatString: "R$" #,##0.00
		displayFolder: 2. Meta
		lineageTag: 0eebac6a-0f55-4d37-b638-69115d18ea08

	/// Receita no mesmo período do ano anterior (SAMEPERIODLASTYEAR sobre dim_calendario).
	measure 'Receita Ano Anterior' = CALCULATE([Receita], SAMEPERIODLASTYEAR(dim_calendario[Data]))
		formatString: "R$" #,##0.00
		displayFolder: 3. Tempo
		lineageTag: 3cfba5b5-479a-4319-8ae3-8bdf623d3525

	/// Variação da Receita contra o mesmo período do ano anterior. Vazio quando falta Receita atual ou base do ano anterior (mês futuro não vira -100%).
	measure 'Receita Var. Anual %' =
			VAR _atual = [Receita]
			VAR _base = [Receita Ano Anterior]
			RETURN IF(ISBLANK(_atual) || ISBLANK(_base), BLANK(), DIVIDE(_atual - _base, _base))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3. Tempo
		lineageTag: b079ffbf-a20a-4970-983b-cd15dc9ebfb0

	/// Receita do período deslocado um mês para trás (DATEADD -1 MONTH).
	measure 'Receita Mês Anterior' = CALCULATE([Receita], DATEADD(dim_calendario[Data], -1, MONTH))
		formatString: "R$" #,##0.00
		displayFolder: 3. Tempo
		lineageTag: b0e74cb9-32cd-40a7-8157-51c62d467986

	/// Variação da Receita contra o mês anterior. Vazio quando falta Receita atual ou base.
	measure 'Receita Var. Mensal %' =
			VAR _atual = [Receita]
			VAR _base = [Receita Mês Anterior]
			RETURN IF(ISBLANK(_atual) || ISBLANK(_base), BLANK(), DIVIDE(_atual - _base, _base))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3. Tempo
		lineageTag: 5b30528c-3150-4124-b716-a3ee85c0ff46

	/// Receita acumulada do início do ano até a última data do contexto (DATESYTD). Vazio em períodos posteriores à última venda.
	measure 'Receita Acumulada Ano' =
			VAR _ultimaVenda = CALCULATE(MAX(fato_vendas[Data]), REMOVEFILTERS())
			RETURN IF(MIN(dim_calendario[Data]) > _ultimaVenda, BLANK(), CALCULATE([Receita], DATESYTD(dim_calendario[Data])))
		formatString: "R$" #,##0.00
		displayFolder: 3. Tempo
		lineageTag: 7c54da06-b52f-4b0b-ba65-4fd119d85782

	/// Meta acumulada do início do ano até a última data do contexto (DATESYTD). Meta é mensal, gravada no dia 1. Vazio em períodos posteriores à última venda.
	measure 'Meta Acumulada Ano' =
			VAR _ultimaVenda = CALCULATE(MAX(fato_vendas[Data]), REMOVEFILTERS())
			RETURN IF(MIN(dim_calendario[Data]) > _ultimaVenda, BLANK(), CALCULATE([Meta], DATESYTD(dim_calendario[Data])))
		formatString: "R$" #,##0.00
		displayFolder: 3. Tempo
		lineageTag: 8b5f3498-e62a-496c-871c-702ce1e9f639

	/// Receita Acumulada Ano sobre Meta Acumulada Ano. Vazio sem meta, sem receita acumulada ou com filtro de cliente, produto, canal ou status.
	measure 'Atingimento Acumulado Ano %' =
			VAR _meta = [Meta Acumulada Ano]
			VAR _receita = [Receita Acumulada Ano]
			VAR _recorteSemMeta =
			    ISFILTERED(dim_clientes) || ISFILTERED(dim_produtos)
			        || ISFILTERED(fato_vendas[Canal]) || ISFILTERED(fato_vendas[Status])
			RETURN IF(_recorteSemMeta || ISBLANK(_meta) || ISBLANK(_receita), BLANK(), DIVIDE(_receita, _meta))
		formatString: 0.0%
		displayFolder: 3. Tempo
		lineageTag: e2bc9193-4f38-4aad-8ac1-50a1a5a68ffe

	/// HTML com 4 cards KPI (Receita, Atingimento da meta, Pedidos, Ticket médio) em uma linha, para o visual HTML Content da página Visão Executiva. Tokens do DESING.md. Ano anterior e meta recortados até a última data com venda. Destaques (decisão do usuário): variação/gap negativos e atingimento < 100% em vermelho #A4262C com sinal; positivos em negrito. Comparações somem sem base.
	measure 'HTML KPIs Visão Executiva' =
			VAR _ultima = CALCULATE(MAX(fato_vendas[Data]), REMOVEFILTERS())
			VAR _receita = [Receita]
			VAR _receitaAA = CALCULATE([Receita Ano Anterior], KEEPFILTERS(dim_calendario[Data] <= _ultima))
			VAR _meta = [Meta Comparável]
			VAR _ating = IF(ISBLANK(_meta) || ISBLANK(_receita), BLANK(), DIVIDE(_receita, _meta))
			VAR _gap = _receita - _meta
			VAR _recorteSemMeta =
			    ISFILTERED(dim_clientes) || ISFILTERED(dim_produtos)
			        || ISFILTERED(fato_vendas[Canal]) || ISFILTERED(fato_vendas[Status])
			VAR _pedidos = [Pedidos]
			VAR _pedidosAA = CALCULATE([Pedidos], SAMEPERIODLASTYEAR(dim_calendario[Data]), KEEPFILTERS(dim_calendario[Data] <= EDATE(_ultima, -12)))
			VAR _ticket = [Ticket Médio]
			VAR _ticketAA = CALCULATE([Ticket Médio], SAMEPERIODLASTYEAR(dim_calendario[Data]), KEEPFILTERS(dim_calendario[Data] <= EDATE(_ultima, -12)))
			VAR _ini = CALCULATE(MIN(fato_vendas[Data]), fato_vendas[Status] = "Faturado")
			VAR _fim = CALCULATE(MAX(fato_vendas[Data]), fato_vendas[Status] = "Faturado")
			VAR _varReceita = IF(ISBLANK(_receitaAA) || _receitaAA = 0, BLANK(), DIVIDE(_receita - _receitaAA, _receitaAA))
			VAR _varPedidos = IF(ISBLANK(_pedidosAA) || _pedidosAA = 0, BLANK(), DIVIDE(_pedidos - _pedidosAA, _pedidosAA))
			VAR _varTicket = IF(ISBLANK(_ticketAA) || _ticketAA = 0, BLANK(), DIVIDE(_ticket - _ticketAA, _ticketAA))
			
			// tokens do DESING.md
			VAR _cTit = "#0B4F35"
			VAR _cSec = "#475D52"
			VAR _neg = "<span style='color:#A4262C;font-weight:600;'>"
			VAR _pos = "<span style='font-weight:700;'>"
			VAR _fmtVar = "+0.0%;-0.0%;0.0%"
			VAR _card = "flex:1;min-width:0;box-sizing:border-box;background:#FFFFFF;border:1px solid #D3E5D5;border-radius:4px;padding:12px 16px;"
			VAR _lbl = "font-size:12pt;color:" & _cSec & ";margin:0 0 4px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
			VAR _val = "font-size:28pt;font-weight:600;color:" & _cTit & ";line-height:1.1;margin:0;white-space:nowrap;"
			VAR _valNeg = "font-size:28pt;font-weight:600;color:#A4262C;line-height:1.1;margin:0;white-space:nowrap;"
			VAR _cmp = "font-size:10pt;color:" & _cSec & ";margin:4px 0 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
			
			VAR _receitaTxt = "R$ " & FORMAT(_receita / 1000000, "#,##0.00") & " mi"
			VAR _receitaCmp =
			    IF(NOT ISBLANK(_varReceita),
			        IF(_varReceita < 0, _neg, _pos) & FORMAT(_varReceita, _fmtVar) & "</span> vs. mesmo período do ano anterior",
			        "Sem base no ano anterior")
			VAR _atingTxt = IF(ISBLANK(_ating), "—", FORMAT(_ating, "0.0%"))
			VAR _atingCmp =
			    SWITCH(TRUE(),
			        _recorteSemMeta, "Meta é por vendedor; não se aplica a este recorte",
			        ISBLANK(_meta), "Meta não definida para o período",
			        "Meta R$ " & FORMAT(_meta / 1000000, "#,##0.00") & " mi · " &
			        IF(_gap >= 0,
			            _pos & "folga de R$ " & FORMAT(_gap / 1000000, "#,##0.00") & " mi</span>",
			            _neg & "faltam R$ " & FORMAT(ABS(_gap) / 1000000, "#,##0.00") & " mi</span>"))
			VAR _pedidosCmp =
			    IF(NOT ISBLANK(_varPedidos),
			        IF(_varPedidos < 0, _neg, _pos) & FORMAT(_varPedidos, _fmtVar) & "</span> vs. mesmo período (" & FORMAT(_pedidosAA, "#,##0") & ")",
			        "Sem base no ano anterior")
			VAR _ticketCmp =
			    IF(NOT ISBLANK(_varTicket),
			        IF(_varTicket < 0, _neg, _pos) & FORMAT(_varTicket, _fmtVar) & "</span> vs. mesmo período (R$ " & FORMAT(_ticketAA, "#,##0") & ")",
			        "Sem base no ano anterior")
			VAR _periodo = "Período com vendas: " & FORMAT(_ini, "dd/mm/yyyy") & " a " & FORMAT(_fim, "dd/mm/yyyy")
			RETURN
			IF(ISBLANK(_receita),
			    "<div style='font-family:Segoe UI,Arial,sans-serif;font-size:12pt;color:" & _cSec & ";background:#FFFFFF;border:1px solid #D3E5D5;border-radius:4px;padding:16px;'>Sem dados para os filtros atuais</div>",
			    "<div style='font-family:Segoe UI,Arial,sans-serif;'>" &
			    "<div style='display:flex;gap:12px;'>" &
			        "<div style='" & _card & "'><p style='" & _lbl & "'>Receita</p><p style='" & _val & "'>" & _receitaTxt & "</p><p style='" & _cmp & "'>" & _receitaCmp & "</p></div>" &
			        "<div style='" & _card & "'><p style='" & _lbl & "'>Atingimento da meta</p><p style='" & IF(NOT ISBLANK(_ating) && _ating < 1, _valNeg, _val) & "'>" & _atingTxt & "</p><p style='" & _cmp & "'>" & _atingCmp & "</p></div>" &
			        "<div style='" & _card & "'><p style='" & _lbl & "'>Pedidos faturados</p><p style='" & _val & "'>" & FORMAT(_pedidos, "#,##0") & "</p><p style='" & _cmp & "'>" & _pedidosCmp & "</p></div>" &
			        "<div style='" & _card & "'><p style='" & _lbl & "'>Ticket médio</p><p style='" & _val & "'>R$ " & FORMAT(_ticket, "#,##0") & "</p><p style='" & _cmp & "'>" & _ticketCmp & "</p></div>" &
			    "</div>" &
			    "<p style='font-size:8pt;color:" & _cSec & ";margin:6px 0 0 0;'>" & _periodo & "</p>" &
			    "</div>"
			)
		displayFolder: 4. HTML
		lineageTag: dd4c894d-9c06-40c1-9134-3bd30e12b0bd

	/// HTML com a frase de insight executivo no contexto dos filtros: receita, variação contra o mesmo período do ano anterior e atingimento da meta com folga/falta. Ano anterior e meta recortados até a última data com venda; meta omitida em recortes de cliente/produto/canal/status. Destaques (decisão do usuário): trechos negativos em vermelho #A4262C, positivos em negrito. Trechos somem quando falta base. Para o visual HTML Content.
	measure 'HTML Narrativa Visão Executiva' =
			VAR _ultima = CALCULATE(MAX(fato_vendas[Data]), REMOVEFILTERS())
			VAR _receita = [Receita]
			VAR _receitaAA = CALCULATE([Receita Ano Anterior], KEEPFILTERS(dim_calendario[Data] <= _ultima))
			VAR _var = IF(ISBLANK(_receitaAA) || _receitaAA = 0, BLANK(), DIVIDE(_receita - _receitaAA, _receitaAA))
			VAR _meta = [Meta Comparável]
			VAR _ating = IF(ISBLANK(_meta), BLANK(), DIVIDE(_receita, _meta))
			VAR _gap = _receita - _meta
			VAR _ini = CALCULATE(MIN(fato_vendas[Data]), fato_vendas[Status] = "Faturado")
			VAR _fim = CALCULATE(MAX(fato_vendas[Data]), fato_vendas[Status] = "Faturado")
			VAR _fmtMi = "#,##0.00"
			VAR _pct = "0.0%"
			VAR _neg = "<span style='color:#A4262C;'>"
			VAR _pos = "<span style='font-weight:700;'>"
			VAR _insight =
			    "Receita de " & _pos & "R$ " & FORMAT(_receita / 1000000, _fmtMi) & " mi</span>" &
			    IF(NOT ISBLANK(_var),
			        ", " & IF(_var >= 0, _pos & FORMAT(_var, _pct) & " acima", _neg & FORMAT(ABS(_var), _pct) & " abaixo") & "</span> do mesmo período do ano anterior", "") &
			    IF(NOT ISBLANK(_ating),
			        ", com " & IF(_ating >= 1, _pos, _neg) & FORMAT(_ating, _pct) & " da meta</span> (" &
			        IF(_gap >= 0, _pos & "folga de R$ " & FORMAT(_gap / 1000000, _fmtMi) & " mi</span>", _neg & "faltam R$ " & FORMAT(ABS(_gap) / 1000000, _fmtMi) & " mi</span>") & ")", "") & "."
			
			// estilos (DESING.md)
			VAR _cTit = "#0B4F35"
			VAR _cSec = "#475D52"
			RETURN
			IF(ISBLANK(_receita),
			    "<div style='font-family:Segoe UI,Arial,sans-serif;font-size:12pt;color:" & _cSec & ";background:#FFFFFF;border:1px solid #D3E5D5;border-radius:4px;padding:16px;'>Sem dados para os filtros atuais</div>",
			    "<div style='font-family:Segoe UI,Arial,sans-serif;box-sizing:border-box;background:#FFFFFF;border:1px solid #D3E5D5;border-radius:4px;padding:16px;'>" &
			    "<p style='font-size:14pt;font-weight:400;color:" & _cTit & ";margin:0;line-height:1.3;'>" & _insight & "</p>" &
			    "</div>"
			)
		displayFolder: 4. HTML
		lineageTag: 69e52bba-9fd1-4acf-acfb-91c49bd72022

	/// Meta recortada até a última data com venda. Vazia quando há filtro de cliente, produto, canal ou status: a meta tem grão vendedor × mês e não se divide por essas dimensões (comparar seria enganoso).
	measure 'Meta Comparável' =
			VAR _ultima = CALCULATE(MAX(fato_vendas[Data]), REMOVEFILTERS())
			VAR _recorteSemMeta =
			    ISFILTERED(dim_clientes) || ISFILTERED(dim_produtos)
			        || ISFILTERED(fato_vendas[Canal]) || ISFILTERED(fato_vendas[Status])
			RETURN
			    IF(_recorteSemMeta, BLANK(), CALCULATE([Meta], KEEPFILTERS(dim_calendario[Data] <= _ultima)))
		formatString: "R$" #,##0.00
		displayFolder: 2. Meta
		lineageTag: 93d9a2c3-5a75-452d-94fe-b440dd8e78be

	column 'Coluna 1'
		dataType: string
		isHidden
		displayFolder: 0. Aux
		lineageTag: 19e8eccc-c0b9-4766-a2c5-18275edf870f
		summarizeBy: none
		sourceColumn: Coluna 1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Medidas = m
		mode: import
		queryGroup: Aux
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}})
				in
				    #"Tipo Alterado"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

